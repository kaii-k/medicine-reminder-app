<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0B"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal">

        <!-- Big alarm icon -->
        <ImageView
            android:id="@+id/alarmIcon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="40dp"
            android:src="@android:drawable/ic_lock_idle_alarm"
            app:tint="#FFFFFF"
            android:contentDescription="Alarm icon"
            android:layout_gravity="center"
            android:animation="@anim/pulse_anim" />

        <!-- Title -->
        <TextView
            android:id="@+id/titleTxt"
            android:layout_marginTop="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MEDICINE REMINDER!"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Info card -->
        <LinearLayout
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_corner"
            android:padding="18dp">

            <TextView
                android:id="@+id/medNameTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Medicine Name"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/doseTxt"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dose: 1 tablet"
                android:textColor="#DDDDDD"
                android:textSize="14sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/notesTxt"
                android:layout_marginTop="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Notes: Take with food"
                android:textColor="#CCCCCC"
                android:textSize="13sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- Buttons row -->
        <LinearLayout
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="2">

            <Button
                android:id="@+id/snoozeBtn"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="SNOOZE"
                android:textAllCaps="true"
                android:layout_marginEnd="10dp"
                android:backgroundTint="#2AA58A"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/dismissBtn"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="DISMISS"
                android:textAllCaps="true"
                android:layout_marginStart="10dp"
                android:backgroundTint="#E74C3C"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <TextView
            android:layout_marginTop="18dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Take your medicine now!"
            android:textColor="#AAAAAA"
            android:textSize="13sp"/>
    </LinearLayout>
</ScrollView>
