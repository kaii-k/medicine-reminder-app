<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Runtime notification permission (Android 13+ must be requested at runtime) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Vibration for alerts -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Allow starting foreground services (required when calling startForeground()) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+: scoped permission required when using mediaPlayback foreground service type -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Re-schedule alarms after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Allow scheduling exact alarms (Android 12+ may require user to allow exact alarms in settings) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Keep WAKE_LOCK for older devices if you need to keep CPU awake briefly -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DayNight.NoActionBar"
        tools:targetApi="31">

        <!-- Main entry -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Add medicine, list, etc -->
        <activity android:name=".AddMedicineActivity" />
        <activity android:name=".MedicineListActivity" />
        <activity android:name=".EditMedicineActivity" />

        <!-- Alarm Activity: lock screen + no action bar -->
        <activity
            android:name=".AlarmActivity"
            android:exported="true"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:showWhenLocked="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"
            android:launchMode="singleTask" />

        <!-- Foreground service to play sound/vibrate -->
        <service
            android:name=".AlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Receiver for snooze/done actions - app-internal, not exported -->
        <receiver
            android:name=".AlarmActionReceiver"
            android:exported="false" />

        <!-- Receiver for alarms - must be exported so AlarmManager can deliver -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="true" />

        <!-- Boot receiver for re-scheduling alarms -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
